{
  "name": "narutotcg",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint \"src/**/*.astro\"",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"astro.config.mjs\" \"eslint.config.js\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"astro.config.mjs\" \"eslint.config.js\" \"package.json\""
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
