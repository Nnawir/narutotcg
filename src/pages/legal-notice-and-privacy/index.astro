---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Legal Notice and Privacy"
  description="Legal notice, contact, and privacy information for NarutoCardGuide."
  canonicalPath="/legal-notice-and-privacy/"
>
  <div class="shell article-shell">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Legal Notice' }]} />
    <article>
      <header class="article-header">
        <div class="article-heading-copy">
          <p class="eyebrow">Legal information</p>
          <h1>Legal Notice and Privacy</h1>
          <p class="article-standfirst">Essential information about NarutoCardGuide.</p>
        </div>
      </header>

      <div class="article-layout">
        <div class="article-body">
          <section aria-labelledby="site-title">
            <h2 id="site-title">About this site</h2>
            <p>
              NarutoCardGuide is an independent reference resource about the NARUTO CARD GAME. The
              site collects confirmed card information, beginner explanations, deck guides, and news
              about announced products and events. It is designed to make the available information
              easier to browse and understand as the game develops.
            </p>
            <p>
              NarutoCardGuide is not affiliated with, sponsored by, or endorsed by Bandai, the NARUTO
              rights holders, or any of their partners. NARUTO and related names, characters, and
              artwork remain the property of their respective owners. All information is provided for
              general reference and should be checked against official announcements when making
              important decisions about products, events, or gameplay.
            </p>
          </section>

          <section aria-labelledby="contact-title">
            <h2 id="contact-title">Contact</h2>
            <p>
              For questions about the site, contact{' '}
              <span class="contact-email"
                >narutocardguide<span aria-hidden="true">&#64;</span>gmail.com</span
              >.
            </p>
          </section>

          <section aria-labelledby="privacy-title">
            <h2 id="privacy-title">Privacy</h2>
            <p>
              We use Google Analytics 4 (GA4) to measure and understand site traffic and improve the
              content. Google may process information such as page views, approximate location,
              device and browser details, and interaction events for this purpose. Analytics data is
              used in aggregate to understand which pages are useful and how the site is being used.
            </p>
            <p>
              The site does not require an account and does not ask visitors to submit personal
              information through a registration form. You can control cookies and similar storage
              technologies through your browser settings. Disabling them may affect analytics
              measurement but should not prevent access to the main reference pages.
            </p>
          </section>

          <section aria-labelledby="content-title">
            <h2 id="content-title">Content and external links</h2>
            <p>
              Some pages link to official websites or other third-party resources. Those websites
              have their own terms, privacy policies, and tracking practices. NarutoCardGuide is not
              responsible for the content, availability, or privacy practices of external websites,
              so review their policies before sharing information or taking action there.
            </p>
          </section>

          <section aria-labelledby="updates-title">
            <h2 id="updates-title">Updates to this notice</h2>
            <p>
              This notice may be updated when the site adds features, changes its analytics setup, or
              publishes new contact and privacy information. The latest version will always be
              available on this page. If you have a question about the site or believe information
              should be corrected, please contact us using the address above.
            </p>
          </section>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
