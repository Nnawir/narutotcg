---
import BaseLayout from '../../components/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guides } from '../../data/content';

const orderedGuides = [...guides].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Beginner Guides"
  description="Learn the NARUTO CARD GAME through an ordered path built from verified rules and official resources."
  canonicalPath="/beginner-guides/"
  noindex={guides.length === 0}
>
  <header class="page-hero shell cards-list-hero">
    <p class="eyebrow card-list-eyebrow">Beginner Guides</p>
    <h1 class="card-list-title">Beginner Guides for Naruto Card Game</h1>
    <p>
      <a class="text-link card-list-news-link" href="/beginner-guides/complete-naruto-card-game-rules/">
        Start learning
      </a>{' '}
      with the essentials, learn to read your cards, and build your game vocabulary one guide at a
      time.
    </p>
  </header>

  <div class="shell">
    <section class="section beginner-guides-section" aria-labelledby="beginner-guides-list-title">
      <h2 id="beginner-guides-list-title" class="visually-hidden">Beginner guide articles</h2>
      {orderedGuides.length > 0 ? (
        <div class="guide-grid">
          {orderedGuides.map((guide) => <GuideCard guide={guide} />)}
        </div>
      ) : (
        <EmptyState
          eyebrow="Learning path ready"
          title="Guides are coming soon"
          message="Beginner guides will be added here as they are prepared."
        />
      )}
    </section>
  </div>
</BaseLayout>
