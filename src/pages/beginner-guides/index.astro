---
import BaseLayout from '../../components/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import GuideCard from '../../components/GuideCard.astro';
import { guides } from '../../data/content';

const orderedGuides = [...guides].sort((a, b) => a.order - b.order);
---

<BaseLayout
  title="Beginner Guides"
  description="Learn the NARUTO CARD GAME through an ordered path built from verified rules and official resources."
  canonicalPath="/beginner-guides/"
  noindex={guides.length === 0}
>
  <header class="page-hero shell cards-list-hero">
    <p class="eyebrow card-list-eyebrow">Beginner Guides</p>
    <h1 class="card-list-title">Beginner Guides for Naruto Card Game</h1>
    <p>
      <a class="text-link card-list-news-link" href="/beginner-guides/complete-naruto-card-game-rules/">
        Start learning
      </a>{' '}
      with the essentials, learn to read your cards, and build your game vocabulary one guide at a
      time.
    </p>
  </header>

  <div class="shell">
    <section class="section beginner-guides-section" aria-labelledby="beginner-guides-list-title">
      <div class="section-heading">
        <div>
          <h2 id="beginner-guides-list-title">Start here</h2>
          <p>Rules references and essential game fundamentals for new players.</p>
        </div>
      </div>
      {orderedGuides.length > 0 ? (
        <div class="guide-grid">
          {orderedGuides.map((guide) => <GuideCard guide={guide} />)}
        </div>
      ) : (
        <EmptyState
          eyebrow="Learning path ready"
          title="Guides are coming soon"
          message="Beginner guides will be added here as they are prepared."
        />
      )}
    </section>

    <section class="section beginner-guides-about" aria-labelledby="about-beginner-guides-title">
      <div class="section-heading">
        <div>
          <h2 id="about-beginner-guides-title">About Beginner Guides</h2>
        </div>
      </div>
      <p>
        New to the NARUTO CARD GAME ? This section gives you a clear path to learn the rules,
        understand your cards, and build a strong foundation for your first games. Start with the
        {' '}<a href="/beginner-guides/complete-naruto-card-game-rules/">Complete Naruto Card Game Rules</a>{' '}
        guide to understand the flow of a match and the role of each card.
      </p>
      <p>
        These guides focus on the fundamentals that remain useful as the game develops, from
        managing Chakra and reading card effects to understanding attacks, Leaders, Characters,
        and the vocabulary used across the game.
      </p>
      <p>
        The guides are written for quick reading while keeping the explanations practical. As new
        cards, products, and official announcements are published, follow the{' '}
        <a href="/news/">latest NARUTO CARD GAME news</a>{' '}
        to stay informed about the game’s releases and updates.
      </p>
    </section>
  </div>
</BaseLayout>
