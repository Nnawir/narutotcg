---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardTile from '../../components/CardTile.astro';
import GuideCard from '../../components/GuideCard.astro';
import type { Guide } from '../../data/content';
import { cards, guides } from '../../data/content';
import { formatDate } from '../../lib/format';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const relatedCards = cards.filter((card) => guide.relatedCardIds.includes(card.id));
const relatedGuides = guides.filter((item) => guide.relatedGuideSlugs.includes(item.slug));
const siteOrigin = Astro.site ?? Astro.url.origin;
const absoluteUrl = (path: string) => new URL(path, siteOrigin).toString();
const renderGuideText = (text: string) =>
  text.replace(
    '[[RECOVERY]]',
    '<span class="inline-keyword inline-keyword-recovery"><img src="/assets/keywords/recovery.webp" alt="Recovery" /></span>',
  ).replace(
    '[[RUSH]]',
    '<span class="inline-keyword inline-keyword-rush"><img src="/assets/keywords/rush.webp" alt="Rush" /></span>',
  ).replace(
    '[[DURING_ATTACK]]',
    '<span class="inline-keyword inline-keyword-during-attack"><img src="/assets/keywords/during-your-opponent\'s-attack.webp" alt="During Your Opponent\'s Attack" /></span>',
  );
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.summary,
    dateModified: guide.verifiedAt,
    mainEntityOfPage: absoluteUrl(`/beginner-guides/${guide.slug}/`),
    ...(guide.image ? { image: absoluteUrl(guide.image.src) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Beginner Guides',
        item: absoluteUrl('/beginner-guides/'),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: guide.title,
        item: absoluteUrl(`/beginner-guides/${guide.slug}/`),
      },
    ],
  },
];
---

<BaseLayout
  title={guide.title}
  description={guide.summary}
  canonicalPath={`/beginner-guides/${guide.slug}/`}
  structuredData={structuredData}
>
  <div class="shell article-shell">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Beginner Guides', href: '/beginner-guides/' },
        { label: guide.title },
      ]}
    />
    <article>
      <header class="article-header guide-article-header">
        <p class="eyebrow card-list-eyebrow">Beginner Guides</p>
        <h1 class="card-list-title">{guide.title}</h1>
        <p class="article-standfirst">{guide.summary}</p>
        <div class="article-meta">
          <span>{guide.difficulty}</span>
          <span>{guide.readingTime}</span>
          <span>
            Verified <time datetime={guide.verifiedAt}>{formatDate(guide.verifiedAt)}</time>
          </span>
        </div>
      </header>

      {(guide.sections.length > 0 || guide.officialResources.length > 0) && (
        <div class="article-layout">
        <div class="article-body">
          {guide.sections.map((section) => (
            <section aria-labelledby={section.id}>
              <h2 id={section.id}>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p set:html={renderGuideText(paragraph)}></p>
              ))}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => <li set:html={renderGuideText(bullet)}></li>)}
                </ul>
              )}
              {section.steps && (
                <ol>
                  {section.steps.map((step) => <li set:html={renderGuideText(step)}></li>)}
                </ol>
              )}
              {section.table && (
                <div
                  class:list={[
                    'article-table-wrap',
                    (section.id === 'keywords' || section.id === 'game-vocabulary') && 'keyword-table-wrap',
                  ]}
                >
                  <table>
                    <thead>
                      <tr>
                        {section.table.headers.map((header) => <th scope="col">{header}</th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row, rowIndex) => (
                        <tr>
                          {row.map((cell, cellIndex) => {
                            const image = section.table?.images?.[rowIndex]?.[cellIndex];
                            const example = section.table?.examples?.[rowIndex];
                            return (
                              <td>
                                {image && section.id === 'keywords' ? (
                                  <button
                                    class="keyword-trigger"
                                    type="button"
                                    data-card-preview
                                    data-image-src={image.src}
                                    data-image-alt={image.alt}
                                    aria-label={`View the ${cell} keyword card image`}
                                  >
                                    [{cell}]
                                  </button>
                                ) : image ? (
                                  <span class="table-cell-with-image">
                                    {cell && <span>{cell}</span>}
                                    <img src={image.src} alt={image.alt} />
                                  </span>
                                ) : (
                                  <span set:html={renderGuideText(cell)}></span>
                                )}
                                {example && cellIndex === 1 && (
                                  <>
                                    <br />
                                    <button
                                      class="table-example-link"
                                      type="button"
                                      data-card-preview
                                      data-image-src={example.image.src}
                                      data-image-alt={example.image.alt}
                                      aria-label={`View example card ${example.label}`}
                                    >
                                      Example: {example.label}
                                    </button>
                                  </>
                                )}
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {section.image && (
                <figure class="guide-section-image">
                  <button
                    class="guide-section-image-button"
                    type="button"
                    data-card-preview
                    data-image-src={section.image.src}
                    data-image-alt={section.image.alt}
                    aria-label={`Zoom ${section.image.alt}`}
                  >
                    <img src={section.image.src} alt={section.image.alt} loading="lazy" />
                  </button>
                </figure>
              )}
              {section.statBlocks?.map((statBlock) => (
                <article class="guide-stat-block">
                  <span class="guide-stat-block-label">{statBlock.label}</span>
                  <div class="guide-stat-block-copy">
                    {statBlock.stats.map((stat) => (
                      <p>
                        <strong>{stat.name}:</strong> {stat.description}
                      </p>
                    ))}
                  </div>
                  <button
                    class="guide-stat-block-image-button"
                    type="button"
                    data-card-preview
                    data-image-src={statBlock.image.src}
                    data-image-alt={statBlock.image.alt}
                    aria-label={`Zoom ${statBlock.image.alt}`}
                  >
                    <img src={statBlock.image.src} alt={statBlock.image.alt} loading="lazy" />
                  </button>
                </article>
              ))}
              {section.cards && (
                <div class="guide-card-type-list">
                  {section.cards.map((card) => (
                    <article class="guide-card-type">
                      <p>{card.text}</p>
                      <button
                        class="guide-card-type-image-button"
                        type="button"
                        data-card-preview
                        data-image-src={card.image.src}
                        data-image-alt={card.image.alt}
                        aria-label={`Zoom ${card.image.alt}`}
                      >
                        <img src={card.image.src} alt={card.image.alt} />
                      </button>
                    </article>
                  ))}
                </div>
              )}
              {section.subsections?.map((subsection) => (
                <div class="article-subsection">
                  <h3 id={subsection.id}>{subsection.heading}</h3>
                  {subsection.paragraphs?.map((paragraph) => (
                    <p set:html={renderGuideText(paragraph)}></p>
                  ))}
                  {subsection.bullets && (
                    <ul>
                      {subsection.bullets.map((bullet) => (
                        <li set:html={renderGuideText(bullet)}></li>
                      ))}
                    </ul>
                  )}
                  {subsection.steps && (
                    <ol>
                      {subsection.steps.map((step) => (
                        <li set:html={renderGuideText(step)}></li>
                      ))}
                    </ol>
                  )}
                  {subsection.table && (
                    <div class="article-table-wrap">
                      <table>
                        <thead>
                          <tr>
                            {subsection.table.headers.map((header) => <th scope="col">{header}</th>)}
                          </tr>
                        </thead>
                        <tbody>
                          {subsection.table.rows.map((row, rowIndex) => (
                            <tr>
                              {row.map((cell, cellIndex) => {
                                const image = subsection.table?.images?.[rowIndex]?.[cellIndex];
                                return (
                                  <td>
                                    {image ? (
                                      <span class="table-cell-with-image">
                                        {cell && <span>{cell}</span>}
                                        <img src={image.src} alt={image.alt} />
                                      </span>
                                    ) : (
                                      cell
                                    )}
                                  </td>
                                );
                              })}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                </div>
              ))}
              {section.links && (
                <p class="guide-inline-links">
                  {section.links.map((link, index) => (
                    <>
                      {index > 0 && ' · '}
                      <a href={link.href}>{link.label}</a>
                    </>
                  ))}
                </p>
              )}
              {section.callout && (
                <aside class="callout">
                  <strong>{section.callout.label}</strong>
                  <p>{section.callout.text}</p>
                </aside>
              )}
            </section>
          ))}

          {guide.officialResources.length > 0 && (
            <section class="source-panel" aria-labelledby="official-resources-title">
              <h2 id="official-resources-title">Official resources</h2>
              <ul>
                {guide.officialResources.map((resource) => (
                  <li>
                    <a class="external-link" href={resource.url} target="_blank" rel="noopener noreferrer">
                      {resource.label}
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>

        {guide.sections.length >= 3 && (
          <aside class="article-aside">
            <h2>On this page</h2>
            <nav aria-label="Guide contents">
              {guide.sections.map((section) => (
                <a href={`#${section.id}`}>{section.heading}</a>
              ))}
              {relatedGuides.length > 0 && <a href="#more-guides-title">Continue learning</a>}
            </nav>
          </aside>
        )}
        </div>
      )}

      {relatedCards.length > 0 && (
        <section class="related-section" aria-labelledby="guide-cards-title">
          <h2 id="guide-cards-title">Related cards</h2>
          <div class="card-grid">
            {relatedCards.map((card) => (
              <CardTile card={card} />
            ))}
          </div>
        </section>
      )}
      {relatedGuides.length > 0 && (
        <section class="related-section" aria-labelledby="more-guides-title">
          <h2 id="more-guides-title">Continue learning</h2>
          <div class="guide-grid">
            {relatedGuides.map((item) => (
              <GuideCard guide={item} />
            ))}
          </div>
        </section>
      )}
    </article>
  </div>
</BaseLayout>
