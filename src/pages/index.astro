---
import BaseLayout from '../components/BaseLayout.astro';
import CardTile from '../components/CardTile.astro';
import EmptyState from '../components/EmptyState.astro';
import NewsCard from '../components/NewsCard.astro';
import { cards, guides, news, releaseMilestones } from '../data/content';

const featuredNews = news.find((article) => article.featured) ?? news[0];
const secondaryNews = news.filter((article) => article.slug !== featuredNews?.slug).slice(0, 3);
const latestCards = [...cards]
  .filter((card) => card.revealedAt)
  .sort((a, b) => (b.revealedAt ?? '').localeCompare(a.revealedAt ?? ''))
  .slice(0, 6);
const beginnerSteps = [
  { title: 'Understand the Game', category: 'Start Here' },
  { title: 'Learn a Turn', category: 'Core Mechanics' },
  { title: 'Build Your First Deck', category: 'First Deck' },
].map((step) => ({ ...step, guide: guides.find((guide) => guide.category === step.category) }));
---

<BaseLayout
  title="NINJA TCG — Independent Naruto Card Game Resource"
  description="Confirmed NARUTO CARD GAME news, revealed cards, and beginner guides for players in the United States. Arriving Summer 2027."
  fullTitle
  canonicalPath="/"
>
  <section class="announcement" aria-label="Release status">
    <div class="shell">
      <strong>Arriving Summer 2027</strong>
      <span>No exact release date has been announced.</span>
    </div>
  </section>

  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Independent game archive · Pre-launch</p>
        <h1>
          Official reveals, card data, and guides <span>for the Naruto Card Game.</span>
        </h1>
        <div class="hero-actions">
          <a class="button" href="/cards-list/">
            Browse Revealed Cards
          </a>
          <a class="button secondary" href="/beginner-guides/">
            Start Learning
          </a>
        </div>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <span class="hero-year">27</span>
        <span class="hero-mark-label">Summer release window</span>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="latest-news-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Verified reporting</p>
        <h2 id="latest-news-title">Latest News</h2>
        <p>Official announcements and careful context, without rumor or filler.</p>
      </div>
      {news.length > 0 && (
        <a class="text-link" href="/news/">
          All news
        </a>
      )}
    </div>

    {featuredNews ? (
      <div class="news-layout">
        <NewsCard article={featuredNews} featured />
        <div class="news-secondary">
          {secondaryNews.map((article) => (
            <NewsCard article={article} />
          ))}
        </div>
      </div>
    ) : (
      <EmptyState
        eyebrow="Newsroom ready"
        title="No confirmed stories yet"
        message="Coverage will begin when verifiable NARUTO CARD GAME announcements are available. We will not publish rumors to fill the page."
      />
    )}
  </section>

  <section class="section shell" aria-labelledby="latest-cards-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Source-backed card data</p>
        <h2 id="latest-cards-title">Latest Card Reveals</h2>
        <p>Images, identifiers, set details, and reveal dates will appear only after they are confirmed.</p>
      </div>
      {cards.length > 0 && (
        <a class="text-link" href="/cards-list/">
          Full card list
        </a>
      )}
    </div>

    {latestCards.length > 0 ? (
      <div class="card-grid">
        {latestCards.map((card, index) => (
          <CardTile card={card} eager={index < 4} />
        ))}
      </div>
    ) : (
      <EmptyState
        eyebrow="Card archive ready"
        title="Revealed cards will appear here"
        message="There are no verified card records in the archive yet. The grid is ready for official card images and confirmed metadata as they are released."
      />
    )}
  </section>

  <section class="section shell" aria-labelledby="new-player-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">A clear starting point</p>
        <h2 id="new-player-title">New to the Game?</h2>
        <p>Follow three practical steps once official rules and deck-building information are available.</p>
      </div>
    </div>
    <div class="learning-path">
      {beginnerSteps.map((step, index) => (
        <article class="learning-step">
          <span class="step-number">Step {index + 1}</span>
          <h3>{step.title}</h3>
          {step.guide ? (
            <a class="text-link" href={`/beginner-guides/${step.guide.slug}/`}>
              Read the guide
            </a>
          ) : (
            <span class="pending">Guide pending official information</span>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" aria-labelledby="timeline-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Confirmed milestones only</p>
        <h2 id="timeline-title">Official Timeline</h2>
        <p>A concise record of dates and release windows that have been confirmed.</p>
      </div>
    </div>
    <ol class="timeline">
      {releaseMilestones.map((milestone) => (
        <li>
          <time>{milestone.period}</time>
          <div>
            <h3>{milestone.title}</h3>
            <p>{milestone.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
