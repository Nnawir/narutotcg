---
import BaseLayout from '../components/BaseLayout.astro';
import CardTile from '../components/CardTile.astro';
import EmptyState from '../components/EmptyState.astro';
import GuideCard from '../components/GuideCard.astro';
import HeroFloatingCards from '../components/HeroFloatingCards.astro';
import NewsCard from '../components/NewsCard.astro';
import { cards, guides, news, quickUpdates } from '../data/content';

const sortedNews = [...news].sort((a, b) =>
  (b.publishedAt ?? '').localeCompare(a.publishedAt ?? ''),
);
const latestPublishedNews = sortedNews[0];
const latestNews = sortedNews.slice(0, 2);
const homeQuickUpdates = [...quickUpdates, ...sortedNews].slice(0, 3);
const featuredCardIds = ['SAMPLE-19', 'SAMPLE-20', 'SAMPLE-21', 'SAMPLE-22'];
const homeCards = featuredCardIds.flatMap((id) => {
  const card = cards.find((item) => item.id === id);
  return card ? [card] : [];
});
const beginnerGuides = [...guides].sort((a, b) => a.order - b.order).slice(0, 2);
---

<BaseLayout
  title="NarutoCardGuide — Naruto Card Game Resource"
  description="Confirmed NARUTO CARD GAME news, revealed cards, and beginner guides for players in the United States. Arriving June 2027."
  fullTitle
  canonicalPath="/"
>
  <section class="announcement" aria-label="Release status">
    <div class="shell">
      <strong>Arriving June 2027</strong>
      <span>The NARUTO CARD GAME is scheduled to launch in June 2027.</span>
    </div>
  </section>

  <section class="home-hero">
    <a class="news-promo" href={latestPublishedNews ? `/news/${latestPublishedNews.slug}/` : '/news/'}>
      <span class="news-promo-badge">New</span>
      <span class="news-promo-copy">
        <strong>{latestPublishedNews?.title ?? 'Latest news'}</strong>
        <span>Latest article</span>
      </span>
      <span class="news-promo-arrow" aria-hidden="true">→</span>
    </a>
    <HeroFloatingCards />
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow card-list-eyebrow">Naruto Card Game Hub</p>
        <h1>
          Naruto Card Game<br />
          <span>official reveals, cards data and guide</span>
        </h1>
        <p>
          A focused reference built from confirmed information ready to grow with the game, one verified
          update at a time.
        </p>
        <div class="hero-actions">
          <a class="button" href="/cards-list/">
            Browse Revealed Cards
          </a>
          <a class="button secondary" href="/beginner-guides/">
            Start Learning
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell latest-news home-quick-updates" aria-labelledby="quick-updates-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow home-mobile-hide-eyebrow">Quick updates</p>
        <h2 id="quick-updates-title">Latest Updates</h2>
      </div>
    </div>
    <div class="latest-news-list">
      {homeQuickUpdates.map((article) => (
        <NewsCard
          article={article}
          compact
          showImage={false}
          clickable
          href={quickUpdates.includes(article) ? '/news/#roadmap' : undefined}
          actionLabel={quickUpdates.includes(article) ? 'Roadmap' : 'Read article'}
        />
      ))}
    </div>
  </section>

  <section class="section shell" aria-labelledby="latest-news-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow home-mobile-hide-eyebrow">Verified reporting</p>
        <h2 id="latest-news-title">Latest Articles News</h2>
        <p>Official announcements and careful context, without rumor or filler.</p>
      </div>
      {news.length > 0 && (
        <a class="text-link home-section-link" href="/news/">
          All news
        </a>
      )}
    </div>

    {latestNews.length > 0 ? (
      <>
        <div class="news-home-grid">
          {latestNews.map((article) => (
            <NewsCard article={article} showImage={false} />
          ))}
        </div>
        <div class="news-view-more-wrap">
          <a class="button secondary" href="/news/">View More</a>
        </div>
      </>
    ) : (
      <EmptyState
        eyebrow="Newsroom ready"
        title="No confirmed stories yet"
        message="Coverage will begin when verifiable NARUTO CARD GAME announcements are available. We will not publish rumors to fill the page."
      />
    )}
  </section>

  <section class="section shell" aria-labelledby="latest-cards-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow home-mobile-hide-eyebrow">New card reveals</p>
        <h2 id="latest-cards-title">Latest Card Reveals</h2>
        <p>Explore the latest revealed cards from Naruto Card Game. Click any card to browse the Cards List.</p>
      </div>
      {cards.length > 0 && (
        <a class="text-link home-section-link" href="/cards-list/">
          Full card list
        </a>
      )}
    </div>

    {homeCards.length > 0 ? (
      <div class="card-grid home-card-grid">
        {homeCards.map((card, index) => (
          <CardTile card={card} eager={index < 4} href="/cards-list/" showDetails={false} />
        ))}
      </div>
    ) : (
      <EmptyState
        eyebrow="Card archive ready"
        title="Revealed cards will appear here"
        message="There are no verified card records in the archive yet. The grid is ready for official card images and confirmed metadata as they are released."
      />
    )}
  </section>

  <section class="section shell" aria-labelledby="new-player-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow home-mobile-hide-eyebrow">A clear starting point</p>
        <h2 id="new-player-title">New to the Game ?</h2>
        <p>Learn the rules, understand your cards, and build a strong foundation for your first games.</p>
      </div>
      <a class="text-link home-section-link" href="/beginner-guides/">Start learning</a>
    </div>
    <div class="guide-grid home-guide-grid">
      {beginnerGuides.map((guide) => <GuideCard guide={guide} />)}
    </div>
  </section>

  <section class="section shell home-seo" aria-labelledby="about-site-title">
    <p class="eyebrow home-mobile-hide-eyebrow">About NarutoCardGuide</p>
    <h2 id="about-site-title">Your Naruto Card Game resource</h2>
    <p>
      NarutoCardGuide is a reference hub for new and aspiring NARUTO CARD GAME players who want clear answers
      about the rules, the cards, and the latest official developments. Every page is built to make the game easier
      to understand, from practical <a href="/beginner-guides/">beginner guides</a>{' '}and confirmed{' '}
      <a href="/news/">news</a>{' '}to a searchable <a href="/cards-list/">card list</a>{' '}with the information
      players need to prepare for their first games.
    </p>
    <p>
      The site is designed to grow with the game as new cards, products, and announcements are released. Expect
      concise explanations, source-backed updates, and a fast, focused experience that helps you learn the rules,
      find the right cards, and follow the NARUTO CARD GAME with confidence.
    </p>
  </section>

</BaseLayout>
