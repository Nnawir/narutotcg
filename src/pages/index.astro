---
const cards = [
  { name: 'Sasuke — Foudre noire', type: 'Attaquant', power: '9 200', color: 'violet' },
  { name: 'Kakashi — Copie parfaite', type: 'Stratège', power: '8 450', color: 'blue' },
  { name: 'Naruto — Volonté ardente', type: 'Héros', power: '9 800', color: 'orange' },
];
const { page = 'home' } = Astro.props;
const pageCopy = {
  home: { tag: "L'arène t'attend", title: 'Joue.<br><em>Éveille-toi.</em><br>Domine.', text: "Construis ton deck, invoque ton clan et impose ta stratégie dans le jeu de cartes à collectionner le plus intense de l'arène.", primary: 'Explorer les cartes', primaryLink: '/cartes', secondary: 'Prochains tournois', secondaryLink: '/tournois' },
  tournois: { tag: 'Compétition officielle', title: 'Entre dans<br><em>l’arène.</em>', text: "Inscris-toi, prépare ton deck et mesure-toi aux meilleurs joueurs de la communauté NINJA TCG.", primary: 'S’inscrire au tournoi', primaryLink: '#events', secondary: 'Voir le classement', secondaryLink: '#events' },
  cartes: { tag: 'Base de données', title: 'La force<br>de ton <em>deck.</em>', text: "Découvre les combattants, techniques et artefacts qui feront basculer chaque duel.", primary: 'Voir la collection', primaryLink: '#collection', secondary: 'Créer mon deck', secondaryLink: '#collection' },
  actualites: { tag: 'Le fil de l’arène', title: 'Toute<br>l’<em>actu.</em>', text: "Nouvelles cartes, résultats, révélations : reste connecté à ce qui fait vibrer l’arène.", primary: 'Dernières nouvelles', primaryLink: '#news', secondary: 'Événements', secondaryLink: '/tournois' },
}[page];
---
<html lang="fr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>NINJA TCG — Le jeu de cartes</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/><style>/* styles intentionally compact */:root{--ink:#070814;--line:rgba(255,255,255,.12);--pink:#f138a6;--cyan:#37d9ff;--orange:#ff7c3e}*{box-sizing:border-box}body{margin:0;color:#f8f7ff;background:var(--ink);font-family:'Space Grotesk',sans-serif;overflow-x:hidden}a{color:inherit;text-decoration:none}.nav{position:absolute;z-index:10;width:100%;display:flex;justify-content:space-between;align-items:center;padding:26px clamp(22px,5vw,80px)}.brand{font-family:'Barlow Condensed';font-size:27px;font-weight:900}.brand span{color:var(--pink)}.menu-btn{display:flex;align-items:center;gap:11px;border:1px solid var(--line);border-radius:999px;padding:10px 15px;background:#07081499;color:white;cursor:pointer;font:700 12px 'Space Grotesk';letter-spacing:.12em}.menu-btn i,.menu-btn i:before,.menu-btn i:after{display:block;width:20px;height:2px;background:var(--cyan);content:'';position:relative}.menu-btn i:before{position:absolute;top:-6px}.menu-btn i:after{position:absolute;top:6px}.drawer{position:fixed;z-index:20;inset:0 0 0 auto;width:min(420px,90vw);padding:36px;background:#111326;transform:translateX(105%);transition:.35s}.drawer.open{transform:none}.drawer-close{float:right;border:0;background:none;color:white;font-size:30px;cursor:pointer}.drawer h2{margin:90px 0 28px;font:900 44px 'Barlow Condensed';text-transform:uppercase}.drawer a{display:block;border-bottom:1px solid var(--line);padding:20px 0;font:700 25px 'Barlow Condensed';text-transform:uppercase}.hero{min-height:760px;display:flex;align-items:center;padding:150px clamp(22px,9vw,150px) 90px;background:linear-gradient(90deg,#070814 0%,rgba(7,8,20,.94) 31%,rgba(7,8,20,.1) 75%,#070814 100%),url('/images/hero-arena.png') center/cover}.hero-content{max-width:620px}.eyebrow{color:var(--cyan);font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.hero h1{font:900 clamp(60px,9vw,130px)/.78 'Barlow Condensed';letter-spacing:-3px;text-transform:uppercase;margin:20px 0 26px}.hero h1 em{font-style:normal;color:var(--pink);text-shadow:4px 4px #651d69}.hero p{font-size:16px;line-height:1.65;color:#b7b8ce;max-width:460px}.actions{display:flex;gap:13px;margin-top:32px}.button{padding:15px 23px;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;border:1px solid var(--pink);background:var(--pink)}.button.alt{background:#0004;border-color:#fff}main{max-width:1280px;margin:auto;padding:40px clamp(22px,5vw,80px) 100px}.section-head{display:flex;justify-content:space-between;align-items:end;margin:45px 0 22px}.section-head h2{font:900 clamp(32px,4vw,54px)/.9 'Barlow Condensed';text-transform:uppercase;margin:0}.section-head a{color:var(--cyan);font-size:12px;font-weight:700;text-transform:uppercase}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{min-height:285px;padding:20px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid var(--line);background:linear-gradient(135deg,#252044,#101223 65%)}.card.violet{color:#c989ff}.card.blue{color:#61e1ff;background:linear-gradient(135deg,#12304c,#101223)}.card.orange{color:#ffb158;background:linear-gradient(135deg,#4a241e,#101223)}.card small{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#fff}.card b{font:800 34px/.9 'Barlow Condensed';text-transform:uppercase;max-width:180px;color:white}.stats{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:15px;font-size:11px;color:#c9cada}.stats strong{font:800 22px 'Barlow Condensed';color:currentColor}.event{margin-top:70px;background:linear-gradient(110deg,#191337,#101326);border:1px solid var(--line);display:grid;grid-template-columns:1fr auto;gap:30px;padding:34px}.event h3{font:800 35px 'Barlow Condensed';text-transform:uppercase;margin:7px 0}.event p{color:#b8b8c9;margin:0}.event-date{font:900 68px/.7 'Barlow Condensed';color:var(--orange);text-align:right}.event-date span{display:block;font-size:16px;margin-top:13px;color:#fff}.footer{border-top:1px solid var(--line);padding:26px max(22px,5vw);color:#777a97;font-size:12px;display:flex;justify-content:space-between}@media(max-width:700px){.hero{min-height:650px;background:linear-gradient(90deg,#070814,rgba(7,8,20,.76)),url('/images/hero-arena.png') 65%/cover}.cards{grid-template-columns:1fr}.event{grid-template-columns:1fr}.event-date{text-align:left}.footer{display:block;line-height:2}}</style></head><body><nav class="nav"><a class="brand" href="/">NINJA<span>•</span>TCG</a><button class="menu-btn" id="open-menu"><i></i> MENU</button></nav><aside class="drawer" id="drawer"><button class="drawer-close" id="close-menu" aria-label="Fermer">×</button><h2>Navigation</h2><a href="/">Accueil</a><a href="/tournois">Tournois</a><a href="/cartes">Liste de cartes</a><a href="/actualites">Actualités</a></aside><section class="hero"><div class="hero-content"><div class="eyebrow">{pageCopy.tag}</div><h1 set:html={pageCopy.title}></h1><p>{pageCopy.text}</p><div class="actions"><a class="button" href={pageCopy.primaryLink}>{pageCopy.primary}</a><a class="button alt" href={pageCopy.secondaryLink}>{pageCopy.secondary}</a></div></div></section><main id={page === 'actualites' ? 'news' : page === 'cartes' ? 'collection' : 'events'}><div class="section-head"><h2>{page === 'tournois' ? 'Tournois à venir' : page === 'actualites' ? 'Dernières nouvelles' : 'Cartes sous les projecteurs'}</h2><a href="/cartes">Voir toutes les cartes →</a></div><div class="cards">{cards.map(card => <article class={`card ${card.color}`}><small>{page === 'actualites' ? 'NOUVEAUTÉ' : card.type}</small><b>{page === 'actualites' ? `L’univers ${card.name} se révèle` : card.name}</b><div class="stats"><span>{page === 'tournois' ? 'Prix total' : 'Puissance'}</span><strong>{page === 'tournois' ? '2 500 €' : card.power}</strong></div></article>)}</div><section class="event"><div><div class="eyebrow">Prochain événement</div><h3>Championnats de l'ombre</h3><p>64 joueurs. Une seule place au sommet. Prépare ton deck et gagne ta légende.</p></div><div class="event-date">21<span>SEPT. 2026</span></div></section></main><footer class="footer"><span>© 2026 NINJA TCG — Tous droits réservés</span><span>Jouer · Collectionner · Conquérir</span></footer><script>const drawer=document.querySelector('#drawer');document.querySelector('#open-menu').addEventListener('click',()=>drawer.classList.add('open'));document.querySelector('#close-menu').addEventListener('click',()=>drawer.classList.remove('open'));</script></body></html>
