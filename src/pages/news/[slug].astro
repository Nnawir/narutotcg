---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardTile from '../../components/CardTile.astro';
import GuideCard from '../../components/GuideCard.astro';
import type { NewsArticle } from '../../data/content';
import { cards, guides, news } from '../../data/content';
import { formatDate } from '../../lib/format';

export function getStaticPaths() {
  return news.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: NewsArticle };
const relatedCards = cards.filter((card) => article.relatedCardIds.includes(card.id));
const relatedGuides = guides.filter((guide) => article.relatedGuideSlugs.includes(guide.slug));
const orderedNews = [...news].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
const articleIndex = orderedNews.findIndex((item) => item.slug === article.slug);
const previousArticle = orderedNews[articleIndex + 1];
const nextArticle = orderedNews[articleIndex - 1];
const siteOrigin = Astro.site ?? Astro.url.origin;
const absoluteUrl = (path: string) => new URL(path, siteOrigin).toString();
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: article.title,
    description: article.summary,
    datePublished: article.publishedAt,
    dateModified: article.updatedAt ?? article.publishedAt,
    mainEntityOfPage: absoluteUrl(`/news/${article.slug}/`),
    ...(article.image ? { image: absoluteUrl(article.image.src) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'News', item: absoluteUrl('/news/') },
      {
        '@type': 'ListItem',
        position: 3,
        name: article.title,
        item: absoluteUrl(`/news/${article.slug}/`),
      },
    ],
  },
];
---

<BaseLayout
  title={article.title}
  description={article.summary}
  canonicalPath={`/news/${article.slug}/`}
  structuredData={structuredData}
>
  <div class="shell article-shell">
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'News', href: '/news/' }, { label: article.title }]}
    />
    <article>
      <header class="article-header">
        <p class="eyebrow">{article.category}</p>
        <h1>{article.title}</h1>
        <p class="article-standfirst">{article.summary}</p>
        <div class="article-meta">
          <span>
            Published <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
          </span>
          {article.updatedAt && (
            <span>
              Updated <time datetime={article.updatedAt}>{formatDate(article.updatedAt)}</time>
            </span>
          )}
        </div>
      </header>

      <div class="article-layout">
        <div class="article-body">
          {article.confirmedFacts.length > 0 && (
            <aside class="key-facts" aria-labelledby="confirmed-title">
              <h2 id="confirmed-title">What is confirmed</h2>
              <ul>
                {article.confirmedFacts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>
            </aside>
          )}

          {article.sections.map((section) => (
            <section aria-labelledby={`section-${section.heading.toLowerCase().replaceAll(' ', '-')}`}>
              <h2 id={`section-${section.heading.toLowerCase().replaceAll(' ', '-')}`}>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ))}

          <div class="source-panel">
            <p class="eyebrow">Official source</p>
            <a class="external-link" href={article.sourceUrl} target="_blank" rel="noopener noreferrer">
              {article.sourceLabel}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </div>
        </div>

        {article.sections.length >= 3 && (
          <aside class="article-aside">
            <h2>On this page</h2>
            <nav aria-label="Article contents">
              {article.sections.map((section) => (
                <a href={`#section-${section.heading.toLowerCase().replaceAll(' ', '-')}`}>
                  {section.heading}
                </a>
              ))}
            </nav>
          </aside>
        )}
      </div>

      {relatedCards.length > 0 && (
        <section class="related-section" aria-labelledby="related-cards-title">
          <h2 id="related-cards-title">Related cards</h2>
          <div class="card-grid">
            {relatedCards.map((card) => (
              <CardTile card={card} />
            ))}
          </div>
        </section>
      )}
      {relatedGuides.length > 0 && (
        <section class="related-section" aria-labelledby="related-guides-title">
          <h2 id="related-guides-title">Related guides</h2>
          <div class="guide-grid">
            {relatedGuides.map((guide) => (
              <GuideCard guide={guide} />
            ))}
          </div>
        </section>
      )}

      {(previousArticle || nextArticle) && (
        <nav class="related-section prev-next" aria-label="More news">
          {previousArticle && (
            <a class="text-link" href={`/news/${previousArticle.slug}/`}>
              Previous: {previousArticle.title}
            </a>
          )}
          {nextArticle && (
            <a class="text-link" href={`/news/${nextArticle.slug}/`}>
              Next: {nextArticle.title}
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
