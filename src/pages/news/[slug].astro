---
import BaseLayout from '../../components/BaseLayout.astro';
import CardTile from '../../components/CardTile.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import type { NewsArticle } from '../../data/content';
import { cards, guides, news, roadmapArticles } from '../../data/content';
import { formatDate } from '../../lib/format';

export function getStaticPaths() {
  return [...news, ...roadmapArticles].map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: NewsArticle };
const relatedCards = cards.filter((card) => article.relatedCardIds.includes(card.id));
const relatedGuides = guides.filter((guide) => article.relatedGuideSlugs.includes(guide.slug));
const orderedNews = [...news, ...roadmapArticles].sort((a, b) =>
  (b.publishedAt ?? '').localeCompare(a.publishedAt ?? '')
);
const articleIndex = orderedNews.findIndex((item) => item.slug === article.slug);
const previousArticle = orderedNews[articleIndex + 1];
const nextArticle = orderedNews[articleIndex - 1];
const siteOrigin = Astro.site ?? Astro.url.origin;
const absoluteUrl = (path: string) => new URL(path, siteOrigin).toString();
const renderNewsText = (text: string) =>
  text.replace('[[ROADMAP]]', '<a class="text-link" href="/news/#roadmap">Roadmap</a>');
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: article.title,
    description: article.summary,
    ...(article.publishedAt
      ? { datePublished: article.publishedAt, dateModified: article.updatedAt ?? article.publishedAt }
      : {}),
    mainEntityOfPage: absoluteUrl(`/news/${article.slug}/`),
    ...(article.image ? { image: absoluteUrl(article.image.src) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'News', item: absoluteUrl('/news/') },
      {
        '@type': 'ListItem',
        position: 3,
        name: article.title,
        item: absoluteUrl(`/news/${article.slug}/`),
      },
    ],
  },
];
---

<BaseLayout
  title={article.title}
  description={article.summary}
  canonicalPath={`/news/${article.slug}/`}
  structuredData={structuredData}
>
  <div class="shell article-shell news-article-shell">
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'News', href: '/news/' }, { label: article.title }]}
    />
    <article>
      <header
        class:list={[
          'article-header',
          {
            'wide-title-header': article.showContents === false,
          },
        ]}
      >
        <div class="article-heading-copy">
          <p class="eyebrow">{article.category}</p>
          <h1 class:list={{ 'starter-deck-title': article.showContents === false }}>
            {article.title}
          </h1>
          {article.showStandfirst !== false && <p class="article-standfirst">{article.summary}</p>}
          <div class="article-meta">
            {article.publishedAt && (
              <span>
                Published <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
              </span>
            )}
            {article.updatedAt && (
              <span>
                Updated <time datetime={article.updatedAt}>{formatDate(article.updatedAt)}</time>
              </span>
            )}
          </div>
        </div>
      </header>

      <div class:list={['article-layout', { 'article-layout-full': article.showContents === false }]}>
        <div class="article-body">
          {article.confirmedFacts.length > 0 && (
            <aside class="key-facts" aria-labelledby="confirmed-title">
              <h2 id="confirmed-title">What is confirmed</h2>
              <ul>
                {article.confirmedFacts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>
            </aside>
          )}

          {article.sections.map((section) => (
            <section aria-labelledby={`section-${section.heading.toLowerCase().replaceAll(' ', '-')}`}>
              <h2 id={`section-${section.heading.toLowerCase().replaceAll(' ', '-')}`}>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => (
                <p set:html={renderNewsText(paragraph)}></p>
              ))}
              {section.image && (
                <figure
                  class:list={[
                    'article-section-image',
                    {
                      'card-section-image': section.image.src.startsWith('/Cards/'),
                      'cheat-sheet-section-image': section.image.src === '/assets/visuals/cheat_sheet.webp',
                    },
                  ]}
                >
                  {section.image.src.startsWith('/Cards/') ? (
                    <button
                      class="article-section-image-button"
                      type="button"
                      data-card-preview
                      data-image-src={section.image.src}
                      data-image-alt={section.image.alt}
                      aria-label={`Zoom ${section.image.alt}`}
                    >
                      <img
                        src={section.image.src}
                        alt={section.image.alt}
                        width={section.image.width}
                        height={section.image.height}
                        loading="lazy"
                      />
                    </button>
                  ) : (
                    <img
                      src={section.image.src}
                      alt={section.image.alt}
                      width={section.image.width}
                      height={section.image.height}
                      loading="lazy"
                    />
                  )}
                </figure>
              )}
              {section.afterImageParagraphs?.map((paragraph) => (
                <p set:html={renderNewsText(paragraph)}></p>
              ))}
              {section.rewards && (
                <div
                  class:list={[
                    'participation-rewards',
                    { 'news-merchandise-rewards': article.slug === 'official-demo-events-announced-worldwide-premier-demo-event' },
                  ]}
                >
                  {section.rewards.map((reward) => (
                    <article class="participation-reward">
                      <button
                        class="participation-reward-preview"
                        type="button"
                        data-card-preview
                        data-image-src={reward.image.src}
                        data-image-alt={reward.image.alt}
                        aria-label={`Zoom ${reward.name}`}
                      >
                        <figure class="participation-reward-image">
                          <img src={reward.image.src} alt={reward.image.alt} width={reward.image.width} height={reward.image.height} loading="lazy" />
                        </figure>
                      </button>
                      {article.slug !== 'official-demo-events-announced-worldwide-premier-demo-event' && (
                        <div>
                          <h3>{reward.name}</h3>
                          <p>{reward.description}</p>
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              )}
              {section.table && (
                <div class="article-table-wrap news-events-table-wrap">
                  <table>
                    <thead>
                      <tr>
                        {section.table.headers.map((header) => <th scope="col">{header}</th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell) => <td>{cell}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {section.cardIds && (
                <div
                  class:list={[
                    'card-grid',
                    'article-card-grid',
                    { 'news-first-set-card-grid': section.cardIds.length === 4 },
                  ]}
                >
                  {cards
                    .filter((card) => section.cardIds?.includes(card.id))
                    .map((card) => <CardTile card={card} showDetails={false} />)}
                </div>
              )}
              {section.closingNavigation && (
                <p>
                  {section.closingNavigation.before}{' '}
                  <a class="text-link article-navigation-link" href={section.closingNavigation.firstHref}>
                    {section.closingNavigation.firstLabel}
                  </a>{' '}
                  {section.closingNavigation.between}{' '}
                  <a class="text-link article-navigation-link" href={section.closingNavigation.secondHref}>
                    {section.closingNavigation.secondLabel}
                  </a>{section.closingNavigation.after}
                </p>
              )}
              {section.eventLinks && (
                <div class="event-link-grid">
                  {section.eventLinks.map((event) => (
                    <a class="event-link-card" href={event.href}>
                      <strong>{event.title}</strong>
                      <span>{event.date}</span>
                      <span class="text-link">Read event information →</span>
                    </a>
                  ))}
                </div>
              )}
              {section.links && (
                <div class="article-inline-links">
                  {section.links.map((link) => (
                    <span>
                      {link.prefix && `${link.prefix} `}
                      <a class="text-link" href={link.href}>{link.label}</a>{link.suffix}
                    </span>
                  ))}
                </div>
              )}
            </section>
          ))}

        </div>

        {article.showContents !== false && article.sections.length >= 3 && (
          <aside class="article-aside">
            <h2>On this page</h2>
            <nav aria-label="Article contents">
              {article.sections.map((section) => (
                <a href={`#section-${section.heading.toLowerCase().replaceAll(' ', '-')}`}>
                  {section.heading}
                </a>
              ))}
            </nav>
          </aside>
        )}
      </div>

      {relatedCards.length > 0 && (
        <section class="related-section" aria-labelledby="related-cards-title">
          <h2 id="related-cards-title">Related cards</h2>
          <div class="card-grid">
            {relatedCards.map((card) => (
              <CardTile card={card} />
            ))}
          </div>
        </section>
      )}
      {relatedGuides.length > 0 && (
        <section class="related-section" aria-labelledby="related-guides-title">
          <h2 id="related-guides-title">Related guides</h2>
          <div class="guide-grid">
            {relatedGuides.map((guide) => (
              <GuideCard guide={guide} />
            ))}
          </div>
        </section>
      )}

      {(previousArticle || nextArticle) && (
        <nav class="related-section prev-next" aria-label="More news">
          {previousArticle && (
            <a class="text-link" href={`/news/${previousArticle.slug}/`}>
              Previous: {previousArticle.title}
            </a>
          )}
          {nextArticle && (
            <a class="text-link" href={`/news/${nextArticle.slug}/`}>
              Next: {nextArticle.title}
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
