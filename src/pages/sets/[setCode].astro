---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CardTile from '../../components/CardTile.astro';
import NewsCard from '../../components/NewsCard.astro';
import type { CardSet } from '../../data/content';
import { cards, news, sets } from '../../data/content';

export function getStaticPaths() {
  return sets.map((set) => ({ params: { setCode: set.slug }, props: { set } }));
}

const { set } = Astro.props as { set: CardSet };
const setCards = cards.filter((card) => set.cardIds.includes(card.id));
const relatedNews = news.filter((article) => set.relatedNewsSlugs.includes(article.slug));
const siteOrigin = Astro.site ?? Astro.url.origin;
const absoluteUrl = (path: string) => new URL(path, siteOrigin).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Naruto Card List',
      item: absoluteUrl('/cards-list/'),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: set.code,
      item: absoluteUrl(`/sets/${set.slug}/`),
    },
  ],
};
---

<BaseLayout
  title={`${set.code} · ${set.name}`}
  description={`Confirmed release information and currently revealed cards for ${set.name} (${set.code}).`}
  canonicalPath={`/sets/${set.slug}/`}
  structuredData={structuredData}
>
  <div class="shell">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Naruto Card List', href: '/cards-list/' },
        { label: set.code },
      ]}
    />
    <header class="page-hero">
      <p class="eyebrow">Card set</p>
      <h1>
        {set.code} · {set.name}
      </h1>
      {set.releaseInformation && <p>{set.releaseInformation}</p>}
    </header>

    <section class="section" aria-labelledby="revealed-cards-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Current archive</p>
          <h2 id="revealed-cards-title">
            {setCards.length} revealed {setCards.length === 1 ? 'card' : 'cards'}
          </h2>
        </div>
      </div>
      <div class="card-grid">
        {setCards.map((card) => (
          <CardTile card={card} />
        ))}
      </div>
    </section>

    <section class="source-panel" aria-labelledby="set-source-title">
      <h2 id="set-source-title" class="eyebrow">
        Official source
      </h2>
      <a class="external-link" href={set.sourceUrl} target="_blank" rel="noopener noreferrer">
        {set.sourceLabel}
        <span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </section>

    {relatedNews.length > 0 && (
      <section class="section" aria-labelledby="set-news-title">
        <h2 id="set-news-title">Related news</h2>
        <div class="news-grid">
          {relatedNews.map((article) => (
            <NewsCard article={article} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
