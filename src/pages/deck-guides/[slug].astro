---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { deckGuides } from '../../data/deck-guides';
import { cards } from '../../data/content';

export function getStaticPaths() {
  return deckGuides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const deckCards = guide.decklist
  .map((entry) => ({ ...entry, card: cards.find((card) => card.id === entry.cardId) }))
  .filter((entry) => entry.card);
const decklistText = guide.decklist
  .map(({ cardId, copies }) => `${copies} x ${cardId.replace('N01', 'N')}`)
  .join('\n');
const isNarutoGuide = guide.slug === 'naruto-uzumaki-demo-deck';
const isSasukeGuide = guide.slug === 'sasuke-uchiha-demo-deck';
---

<BaseLayout title={guide.title} description={guide.summary} canonicalPath={`/deck-guides/${guide.slug}/`}>
  <div class="shell">
    <Breadcrumbs items={[{ label: 'Deck Guides', href: '/deck-guides/' }, { label: guide.title }]} />
  </div>
  <header class="guide-article-header deck-guide-detail-hero shell">
    <div class="deck-guide-detail-copy">
      <p class="eyebrow card-list-eyebrow">Deck Guides</p>
      <h1>{guide.title}</h1>
      <p class="article-standfirst">
        {guide.intro}
      </p>
      {(isNarutoGuide || isSasukeGuide) && <a class="guide-jump-badge" href="#matchup">Matchup <span aria-hidden="true">↓</span></a>}
    </div>
    <figure class="deck-guide-detail-image">
      <img src={guide.image.src} alt={guide.image.alt} />
    </figure>
  </header>
  <article class="shell guide-article deck-guide-article">
    <section class="guide-content-section decklist-section" id="decklist">
      <div class="decklist-heading">
        <div>
          <h2>Decklist</h2>
          <p class="decklist-intro">The complete {guide.decklist.reduce((total, entry) => total + entry.copies, 0)}-card {guide.title}.</p>
        </div>
        <button class="copy-sim-button" type="button" data-copy-deck data-decklist={decklistText}>Copy for Sim</button>
      </div>
      <div class="decklist-grid">
        {deckCards.map(({ card, copies }) => (
          <article class="decklist-card">
            <button
              class="decklist-card-button"
              type="button"
              data-card-preview
              data-image-src={card.image.src}
              data-image-alt={card.image.alt}
              aria-label={`Zoom ${card.id} card`}
            >
              <span class="decklist-card-image">
                <img src={card.image.src} alt={card.image.alt} width={card.image.width} height={card.image.height} loading="lazy" />
              </span>
              <span class="decklist-card-copy">
                <strong>{copies}x</strong>
                <span>{card.id}</span>
              </span>
            </button>
          </article>
        ))}
      </div>
    </section>
    {isNarutoGuide && <section class="guide-content-section combo-guide-section" id="main-actions-and-combos">
      <h2>Main actions and Combos</h2>

      <div class="combo-guide-list">
      <article class="combo-guide-row">
        <div class="combo-guide-cards">
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-007.webp" data-image-alt="Minato N01-007 card" aria-label="Zoom Minato N01-007 card">
            <img src="/Cards/N01/N01-007.webp" alt="Minato N01-007" loading="lazy" />
          </button>
          <span class="combo-effect-chip">Leader effect<br /><strong>+3 power</strong></span>
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-005.webp" data-image-alt="Gamabunta N01-005 card" aria-label="Zoom Gamabunta N01-005 card">
            <img src="/Cards/N01/N01-005.webp" alt="Gamabunta N01-005" loading="lazy" />
          </button>
        </div>
        <div class="combo-guide-copy">
          <h3>Minato loop with Gamabunta</h3>
          <p>Summon Minato and attack the opponent. Boost Minato with Naruto’s Leader effect, then play Gamabunta to send Minato to the trash. Use Gamabunta’s effect to play Minato again, then attack with the newly summoned Minato.</p>
        </div>
      </article>

      <article class="combo-guide-row">
        <div class="combo-guide-cards">
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-003.webp" data-image-alt="Naruto N01-003 card" aria-label="Zoom Naruto N01-003 card">
            <img src="/Cards/N01/N01-003.webp" alt="Naruto N01-003" loading="lazy" />
          </button>
          <span class="combo-arrow" aria-hidden="true">+</span>
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-003.webp" data-image-alt="Naruto N01-003 card" aria-label="Zoom second Naruto N01-003 card">
            <img src="/Cards/N01/N01-003.webp" alt="Naruto N01-003" loading="lazy" />
          </button>
        </div>
        <div class="combo-guide-copy">
          <h3>Naruto power threshold</h3>
          <p>Summon a Character onto the field and boost it with the Leader effect until it reaches 10 power. Play Naruto N01-003, then summon another copy of Naruto N01-003 from the trash or from the deck to keep the pressure going.</p>
        </div>
      </article>

      <article class="combo-guide-row">
        <div class="combo-guide-cards">
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-011.webp" data-image-alt="Ino N01-011 card" aria-label="Zoom Ino N01-011 card">
            <img src="/Cards/N01/N01-011.webp" alt="Ino N01-011" loading="lazy" />
          </button>
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-008.webp" data-image-alt="Shikamaru N01-008 card" aria-label="Zoom Shikamaru N01-008 card">
            <img src="/Cards/N01/N01-008.webp" alt="Shikamaru N01-008" loading="lazy" />
          </button>
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-002.webp" data-image-alt="Choji N01-002 card" aria-label="Zoom Choji N01-002 card">
            <img src="/Cards/N01/N01-002.webp" alt="Choji N01-002" loading="lazy" />
          </button>
        </div>
        <div class="combo-guide-copy">
          <h3>Ino, Shikamaru, and Choji pressure</h3>
          <p>Activate Shikamaru with its During Your Opponent’s Attack effect during the opponent’s turn. On your turn, summon Choji by paying a Chakra, then summon Ino. All three Characters gain Rush, +5 power, and +1 damage, creating immediate pressure on the opponent.</p>
        </div>
      </article>

      <article class="combo-guide-row">
        <div class="combo-guide-cards">
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-004.webp" data-image-alt="Naruto N01-004 card" aria-label="Zoom Naruto N01-004 card">
            <img src="/Cards/N01/N01-004.webp" alt="Naruto N01-004" loading="lazy" />
          </button>
        </div>
        <div class="combo-guide-copy">
          <h3>Naruto board clear</h3>
          <p>Spend 2 Chakra to KO all Characters, including your own and your opponent’s. This effect is especially useful when you need to clear the board and reset the pace of the game.</p>
        </div>
      </article>
      </div>
    </section>}
    {isNarutoGuide && <section class="guide-content-section defensive-guide-section" id="main-defensive-moves">
      <h2>Main Defensive Moves</h2>
      <div class="combo-guide-list">
        <article class="combo-guide-row">
          <div class="combo-guide-cards">
            <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-009.webp" data-image-alt="Kakashi N01-009 card" aria-label="Zoom Kakashi N01-009 card">
              <img src="/Cards/N01/N01-009.webp" alt="Kakashi N01-009" loading="lazy" />
            </button>
          </div>
          <div class="combo-guide-copy">
            <h3>Kakashi</h3>
            <p>Negate the effect of a card to stop an opposing support effect or protect an important attack.</p>
          </div>
        </article>

        <article class="combo-guide-row">
          <div class="combo-guide-cards">
            <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-018.webp" data-image-alt="Hinata N01-018 card" aria-label="Zoom Hinata N01-018 card">
              <img src="/Cards/N01/N01-018.webp" alt="Hinata N01-018" loading="lazy" />
            </button>
          </div>
          <div class="combo-guide-copy">
            <h3>Hinata</h3>
            <p>KO an opposing Character during an attack by one of your opponent’s Characters, turning their attack into a defensive opening.</p>
          </div>
        </article>

        <article class="combo-guide-row">
          <div class="combo-guide-cards">
            <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-006.webp" data-image-alt="Jiraiya N01-006 card" aria-label="Zoom Jiraiya N01-006 card">
              <img src="/Cards/N01/N01-006.webp" alt="Jiraiya N01-006" loading="lazy" />
            </button>
          </div>
          <div class="combo-guide-copy">
            <h3>Jiraiya</h3>
            <p>KO two opposing Characters in Rest, giving the deck a strong way to punish a wide board and clear blockers.</p>
          </div>
        </article>
      </div>
    </section>}
    {isNarutoGuide && <section class="guide-content-section matchup-guide-section" id="matchup">
      <h2>Matchup</h2>
      <article class="matchup-guide-card">
        <button class="matchup-leader-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-012.webp" data-image-alt="Sasuke Uchiha N01-012 leader card" aria-label="Zoom Sasuke Uchiha N01-012 leader card">
          <img src="/Cards/N01/N01-012.webp" alt="Sasuke Uchiha leader" loading="lazy" />
        </button>
        <h3>Sasuke Uchiha</h3>
        <ul>
          <li>Aim to go second so you can draw two cards and mulligan, giving you the best chance of finding the pieces you need.</li>
          <li>Prioritize finding Gamabunta so you can access the Gamabunta–Minato combo.</li>
          <li>Try to remove the opposing Jugo from the board by KOing it with your support effects.</li>
          <li>Clear the opponent’s board whenever possible so they cannot use it to summon their EX Characters.</li>
        </ul>
      </article>
    </section>}
    {isSasukeGuide && <>
      <section class="guide-content-section combo-guide-section" id="main-actions-and-combos">
        <h2>Main actions and Combos</h2>
        <div class="combo-guide-list">
          <article class="combo-guide-row">
            <div class="combo-guide-cards">
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-012.webp" data-image-alt="Sasuke Uchiha leader N01-012 card" aria-label="Zoom Sasuke Uchiha leader N01-012 card"><img src="/Cards/N01/N01-012.webp" alt="Sasuke Uchiha leader" loading="lazy" /></button>
              <span class="combo-arrow" aria-hidden="true">+</span>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-019.webp" data-image-alt="Jugo N01-019 card" aria-label="Zoom Jugo N01-019 card"><img src="/Cards/N01/N01-019.webp" alt="Jugo" loading="lazy" /></button>
            </div>
            <div class="combo-guide-copy"><h3>Sasuke Leader + Jugo</h3><p>Summon Jugo. On the following turn, use the Leader effect to place a non-EX card on top of your deck, then use Jugo to summon that prepared card and extend your board.</p></div>
          </article>

          <article class="combo-guide-row">
            <div class="combo-guide-cards">
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-012.webp" data-image-alt="Sasuke Uchiha leader N01-012 card" aria-label="Zoom Sasuke Uchiha leader N01-012 card"><img src="/Cards/N01/N01-012.webp" alt="Sasuke Uchiha leader" loading="lazy" /></button>
              <span class="combo-arrow" aria-hidden="true">+</span>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-022.webp" data-image-alt="Manda N01-022 card" aria-label="Zoom Manda N01-022 card"><img src="/Cards/N01/N01-022.webp" alt="Manda" loading="lazy" /></button>
            </div>
            <div class="combo-guide-copy"><h3>Sasuke Leader + Manda</h3><p>Activate the Leader effect to place a non-EX card on top of your deck. Summon Manda, place a Character from the field into the trash, and then play the prepared non-EX card from the top of your deck.</p></div>
          </article>

          <article class="combo-guide-row">
            <div class="combo-guide-cards">
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-019.webp" data-image-alt="Jugo N01-019 card" aria-label="Zoom Jugo N01-019 card"><img src="/Cards/N01/N01-019.webp" alt="Jugo" loading="lazy" /></button>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-010.webp" data-image-alt="Karin N01-010 card" aria-label="Zoom Karin N01-010 card"><img src="/Cards/N01/N01-010.webp" alt="Karin" loading="lazy" /></button>
              <span class="combo-arrow" aria-hidden="true">+</span>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-014.webp" data-image-alt="Sasuke Uchiha N01-014 card" aria-label="Zoom Sasuke Uchiha N01-014 card"><img src="/Cards/N01/N01-014.webp" alt="Sasuke Uchiha" loading="lazy" /></button>
            </div>
            <div class="combo-guide-copy"><h3>Jugo or Karin + Sasuke</h3><p>Keep a Character on the board, then summon Jugo and/or activate Karin’s Support effect. Follow with Sasuke to KO an opposing Character and turn that setup into immediate pressure.</p></div>
          </article>

          <article class="combo-guide-row">
            <div class="combo-guide-cards">
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-012.webp" data-image-alt="Sasuke Uchiha leader N01-012 card" aria-label="Zoom Sasuke Uchiha leader N01-012 card"><img src="/Cards/N01/N01-012.webp" alt="Sasuke Uchiha leader" loading="lazy" /></button>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-013.webp" data-image-alt="Itachi Uchiha N01-013 card" aria-label="Zoom Itachi Uchiha N01-013 card"><img src="/Cards/N01/N01-013.webp" alt="Itachi Uchiha" loading="lazy" /></button>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-022.webp" data-image-alt="Manda N01-022 card" aria-label="Zoom Manda N01-022 card"><img src="/Cards/N01/N01-022.webp" alt="Manda" loading="lazy" /></button>
            </div>
            <div class="combo-guide-copy"><h3>Sasuke Leader + Itachi + Manda</h3><p>Use the Leader effect to place an Uchiha Clan card on top of your deck. Summon Itachi to stop a Leader or Character from attacking, then summon Manda to turn the prepared top card into another play.</p></div>
          </article>
        </div>
      </section>

      <section class="guide-content-section combo-guide-section playing-ex-guide-section" id="playing-sasuke-ex">
        <h2>Playing Sasuke EX</h2>
        <div class="combo-guide-list">
          <article class="combo-guide-row">
            <div class="combo-guide-cards">
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-012.webp" data-image-alt="Sasuke Uchiha leader N01-012 card" aria-label="Zoom Sasuke Uchiha leader N01-012 card"><img src="/Cards/N01/N01-012.webp" alt="Sasuke Uchiha leader" loading="lazy" /></button>
            </div>
            <div class="combo-guide-copy"><h3>Build the top deck</h3><p>Sasuke Leader can do more than set up a good reveal. Once per turn, use the Leader effect to place the card you want from your hand on top of your deck. That setup can turn Jugo or Manda into a way to reach Sasuke EX.</p></div>
          </article>

          <article class="combo-guide-row">
            <div class="combo-guide-cards">
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-019.webp" data-image-alt="Jugo N01-019 card" aria-label="Zoom Jugo N01-019 card"><img src="/Cards/N01/N01-019.webp" alt="Jugo" loading="lazy" /></button>
              <span class="combo-arrow" aria-hidden="true">+</span>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-015.webp" data-image-alt="Sasuke Uchiha N01-015 card" aria-label="Zoom Sasuke Uchiha N01-015 card"><img src="/Cards/N01/N01-015.webp" alt="Sasuke Uchiha" loading="lazy" /></button>
            </div>
            <div class="combo-guide-copy"><h3>Line 1 · Jugo already on board</h3><p>Use Sasuke Leader to place the non-EX Sasuke on top of your deck. When Jugo attacks, let him reveal the prepared card. Sasuke Uchiha is revealed, so Jugo can summon it and help meet the Sasuke EX summon requirements.</p></div>
          </article>

          <article class="combo-guide-row">
            <div class="combo-guide-cards">
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-022.webp" data-image-alt="Manda N01-022 card" aria-label="Zoom Manda N01-022 card"><img src="/Cards/N01/N01-022.webp" alt="Manda" loading="lazy" /></button>
              <span class="combo-arrow" aria-hidden="true">+</span>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-015.webp" data-image-alt="Sasuke Uchiha N01-015 card" aria-label="Zoom Sasuke Uchiha N01-015 card"><img src="/Cards/N01/N01-015.webp" alt="Sasuke Uchiha" loading="lazy" /></button>
              <span class="combo-arrow" aria-hidden="true">+</span>
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-019.webp" data-image-alt="Jugo N01-019 card" aria-label="Zoom Jugo N01-019 card"><img src="/Cards/N01/N01-019.webp" alt="Jugo" loading="lazy" /></button>
            </div>
            <div class="combo-guide-copy"><h3>Line 2 · Manda in hand</h3><p>Use Sasuke Leader to stack Jugo, then normally summon the non-EX Sasuke. Summon Manda and place that Sasuke from the field into the trash. Manda reveals the top card, and because Jugo is non-EX, Manda can summon it to complete the line.</p></div>
          </article>

          <article class="combo-guide-row">
            <div class="combo-guide-cards">
              <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-014.webp" data-image-alt="Sasuke Uchiha N01-014 card" aria-label="Zoom Sasuke Uchiha N01-014 card"><img src="/Cards/N01/N01-014.webp" alt="Sasuke Uchiha" loading="lazy" /></button>
            </div>
            <div class="combo-guide-copy"><h3>Sasuke EX is ready</h3><p>Both lines can lead to Sasuke EX, giving you Rush and an on-summon K.O. effect. They also spend two Characters from your board to meet the summon requirements, so choose the line that best fits the board state and what you need this turn.</p></div>
          </article>
        </div>
      </section>

      <section class="guide-content-section defensive-guide-section" id="main-defensive-moves">
        <h2>Main Defensive Moves</h2>
        <div class="combo-guide-list">
          <article class="combo-guide-row"><div class="combo-guide-cards"><button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-010.webp" data-image-alt="Karin N01-010 card" aria-label="Zoom Karin N01-010 card"><img src="/Cards/N01/N01-010.webp" alt="Karin" loading="lazy" /></button></div><div class="combo-guide-copy"><h3>Karin</h3><p>Recover 2 Life when she is summoned through her Support effect. Because that effect summons Karin, she is also a useful way to trigger Sasuke N01-014.</p></div></article>
          <article class="combo-guide-row"><div class="combo-guide-cards"><button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-016.webp" data-image-alt="Shisui Uchiha N01-016 card" aria-label="Zoom Shisui Uchiha N01-016 card"><img src="/Cards/N01/N01-016.webp" alt="Shisui Uchiha" loading="lazy" /></button></div><div class="combo-guide-copy"><h3>Shisui Uchiha</h3><p>Negate the effect of a card. The important drawback is that you cannot turn your Chakra cards face-up until the end of your next End Phase.</p></div></article>
          <article class="combo-guide-row"><div class="combo-guide-cards"><button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-021.webp" data-image-alt="Suigetsu Hozuki N01-021 card" aria-label="Zoom Suigetsu Hozuki N01-021 card"><img src="/Cards/N01/N01-021.webp" alt="Suigetsu Hozuki" loading="lazy" /></button></div><div class="combo-guide-copy"><h3>Hozuki</h3><p>Protect a Character from opposing Support effects. Hozuki is summoned when you activate his Support, making him another useful way to enable Sasuke N01-014.</p></div></article>
          <article class="combo-guide-row"><div class="combo-guide-cards"><button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-017.webp" data-image-alt="Orochimaru N01-017 card" aria-label="Zoom Orochimaru N01-017 card"><img src="/Cards/N01/N01-017.webp" alt="Orochimaru" loading="lazy" /></button><button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-015.webp" data-image-alt="Sasuke Uchiha N01-015 card" aria-label="Zoom Sasuke Uchiha N01-015 card"><img src="/Cards/N01/N01-015.webp" alt="Sasuke Uchiha" loading="lazy" /></button></div><div class="combo-guide-copy"><h3>Orochimaru + Sasuke N01-015</h3><p>Use their removal effects to clear the opponent’s board. This pair gives the deck a strong way to control opposing Characters and keep the board manageable.</p></div></article>
          <article class="combo-guide-row"><div class="combo-guide-cards"><button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-020.webp" data-image-alt="Sakura N01-020 card" aria-label="Zoom Sakura N01-020 card"><img src="/Cards/N01/N01-020.webp" alt="Sakura" loading="lazy" /></button></div><div class="combo-guide-copy"><h3>Sakura</h3><p>Return a Character to its owner’s hand during the opponent’s attack, giving you a flexible way to interrupt an opposing board.</p></div></article>
        </div>
      </section>
      <section class="guide-content-section matchup-guide-section" id="matchup">
        <h2>Matchup</h2>
        <div class="matchup-pair-grid">
          <article class="matchup-guide-card">
            <button class="matchup-leader-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-001.webp" data-image-alt="Naruto Uzumaki N01-001 leader card" aria-label="Zoom Naruto Uzumaki N01-001 leader card">
              <img src="/Cards/N01/N01-001.webp" alt="Naruto Uzumaki leader" loading="lazy" />
            </button>
            <h3>Naruto Uzumaki</h3>
            <ul>
              <li>Play second to give yourself a chance to mulligan and find the cards you want.</li>
              <li>Play a Character even if it has a Support effect. It is better than passing, and it gives you future targets for EX Character effects.</li>
              <li>KO or return Minato to its owner’s hand to stop the Gamabunta–Minato combo.</li>
              <li>Naruto is an aggressive deck, so remove its Characters before it can chain together multiple attacks.</li>
            </ul>
          </article>

          <article class="matchup-guide-card">
            <button class="matchup-leader-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-012.webp" data-image-alt="Sasuke Uchiha N01-012 leader card" aria-label="Zoom Sasuke Uchiha N01-012 leader card">
              <img src="/Cards/N01/N01-012.webp" alt="Sasuke Uchiha leader" loading="lazy" />
            </button>
            <h3>Sasuke Uchiha</h3>
            <ul>
              <li>Freeze, return, or KO the opposing Jugo before it generates value.</li>
              <li>Play EX Sasuke to KO a Character and attack a Character in Rest, such as Jugo.</li>
              <li>The mirror match is long and demanding. Stay focused and manage the opposing board as carefully as possible.</li>
            </ul>
          </article>
        </div>
      </section>
    </>}
    {guide.sections.map((section) => (
      <section class="guide-content-section" id={section.heading === 'Matchup' ? 'matchup' : undefined}>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
      </section>
    ))}
    <p class="guide-back-link"><a class="text-link" href="/deck-guides/">← Back to Deck Guides</a></p>
  </article>
</BaseLayout>

<script>
  const copyDeckButton = document.querySelector('[data-copy-deck]');
  const decklistText = copyDeckButton instanceof HTMLElement ? copyDeckButton.dataset.decklist ?? '' : '';

  copyDeckButton?.addEventListener('click', async () => {
    if (!(copyDeckButton instanceof HTMLButtonElement)) return;
    try {
      await navigator.clipboard.writeText(decklistText);
      copyDeckButton.textContent = 'Copied!';
      window.setTimeout(() => {
        copyDeckButton.textContent = 'Copy for Sim';
      }, 1800);
    } catch {
      copyDeckButton.textContent = 'Copy failed';
      window.setTimeout(() => {
        copyDeckButton.textContent = 'Copy for Sim';
      }, 1800);
    }
  });
</script>
