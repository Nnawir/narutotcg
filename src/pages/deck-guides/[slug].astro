---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { deckGuides } from '../../data/deck-guides';
import { cards } from '../../data/content';

export function getStaticPaths() {
  return deckGuides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const deckCards = guide.decklist
  .map((entry) => ({ ...entry, card: cards.find((card) => card.id === entry.cardId) }))
  .filter((entry) => entry.card);
---

<BaseLayout title={guide.title} description={guide.summary} canonicalPath={`/deck-guides/${guide.slug}/`}>
  <div class="shell">
    <Breadcrumbs items={[{ label: 'Deck Guides', href: '/deck-guides/' }, { label: guide.title }]} />
  </div>
  <header class="guide-article-header deck-guide-detail-hero shell">
    <div class="deck-guide-detail-copy">
      <p class="eyebrow card-list-eyebrow">Deck Guides</p>
      <h1>{guide.title}</h1>
      <p class="article-standfirst">
        Explore the 31-card Naruto Uzumaki demo deck, including the decklist, core combos, and strategies for playing against Sasuke Leader and the Naruto mirror match.
      </p>
      <a class="guide-jump-badge" href="#matchup">Matchup <span aria-hidden="true">↓</span></a>
    </div>
    <figure class="deck-guide-detail-image">
      <img src={guide.image.src} alt={guide.image.alt} />
    </figure>
  </header>
  <article class="shell guide-article deck-guide-article">
    <section class="guide-content-section decklist-section" id="decklist">
      <div class="decklist-heading">
        <div>
          <h2>Decklist</h2>
          <p class="decklist-intro">The complete 31-card Naruto Uzumaki Demo Deck.</p>
        </div>
        <button class="copy-sim-button" type="button" data-copy-deck>Copy for Sim</button>
      </div>
      <div class="decklist-grid">
        {deckCards.map(({ card, copies }) => (
          <article class="decklist-card">
            <button
              class="decklist-card-button"
              type="button"
              data-card-preview
              data-image-src={card.image.src}
              data-image-alt={card.image.alt}
              aria-label={`Zoom ${card.id} card`}
            >
              <span class="decklist-card-image">
                <img src={card.image.src} alt={card.image.alt} width={card.image.width} height={card.image.height} loading="lazy" />
              </span>
              <span class="decklist-card-copy">
                <strong>{copies}x</strong>
                <span>{card.id}</span>
              </span>
            </button>
          </article>
        ))}
      </div>
    </section>
    <section class="guide-content-section combo-guide-section" id="main-actions-and-combos">
      <h2>Main actions and Combos</h2>

      <div class="combo-guide-list">
      <article class="combo-guide-row">
        <div class="combo-guide-cards">
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-007.webp" data-image-alt="Minato N01-007 card" aria-label="Zoom Minato N01-007 card">
            <img src="/Cards/N01/N01-007.webp" alt="Minato N01-007" loading="lazy" />
          </button>
          <span class="combo-effect-chip">Leader effect<br /><strong>+3 power</strong></span>
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-005.webp" data-image-alt="Gamabunta N01-005 card" aria-label="Zoom Gamabunta N01-005 card">
            <img src="/Cards/N01/N01-005.webp" alt="Gamabunta N01-005" loading="lazy" />
          </button>
        </div>
        <div class="combo-guide-copy">
          <h3>Minato loop with Gamabunta</h3>
          <p>Summon Minato and attack the opponent. Boost Minato with Naruto’s Leader effect, then play Gamabunta to send Minato to the trash. Use Gamabunta’s effect to play Minato again, then attack with the newly summoned Minato.</p>
        </div>
      </article>

      <article class="combo-guide-row">
        <div class="combo-guide-cards">
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-003.webp" data-image-alt="Naruto N01-003 card" aria-label="Zoom Naruto N01-003 card">
            <img src="/Cards/N01/N01-003.webp" alt="Naruto N01-003" loading="lazy" />
          </button>
          <span class="combo-arrow" aria-hidden="true">+</span>
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-003.webp" data-image-alt="Naruto N01-003 card" aria-label="Zoom second Naruto N01-003 card">
            <img src="/Cards/N01/N01-003.webp" alt="Naruto N01-003" loading="lazy" />
          </button>
        </div>
        <div class="combo-guide-copy">
          <h3>Naruto power threshold</h3>
          <p>Summon a Character onto the field and boost it with the Leader effect until it reaches 10 power. Play Naruto N01-003, then summon another copy of Naruto N01-003 from the trash or from the deck to keep the pressure going.</p>
        </div>
      </article>

      <article class="combo-guide-row">
        <div class="combo-guide-cards">
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-011.webp" data-image-alt="Ino N01-011 card" aria-label="Zoom Ino N01-011 card">
            <img src="/Cards/N01/N01-011.webp" alt="Ino N01-011" loading="lazy" />
          </button>
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-008.webp" data-image-alt="Shikamaru N01-008 card" aria-label="Zoom Shikamaru N01-008 card">
            <img src="/Cards/N01/N01-008.webp" alt="Shikamaru N01-008" loading="lazy" />
          </button>
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-002.webp" data-image-alt="Choji N01-002 card" aria-label="Zoom Choji N01-002 card">
            <img src="/Cards/N01/N01-002.webp" alt="Choji N01-002" loading="lazy" />
          </button>
        </div>
        <div class="combo-guide-copy">
          <h3>Ino, Shikamaru, and Choji pressure</h3>
          <p>Activate Shikamaru with its During Your Opponent’s Attack effect during the opponent’s turn. On your turn, summon Choji by paying a Chakra, then summon Ino. All three Characters gain Rush, +5 power, and +1 damage, creating immediate pressure on the opponent.</p>
        </div>
      </article>

      <article class="combo-guide-row">
        <div class="combo-guide-cards">
          <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-004.webp" data-image-alt="Naruto N01-004 card" aria-label="Zoom Naruto N01-004 card">
            <img src="/Cards/N01/N01-004.webp" alt="Naruto N01-004" loading="lazy" />
          </button>
        </div>
        <div class="combo-guide-copy">
          <h3>Naruto board clear</h3>
          <p>Spend 2 Chakra to KO all Characters, including your own and your opponent’s. This effect is especially useful when you need to clear the board and reset the pace of the game.</p>
        </div>
      </article>
      </div>
    </section>
    <section class="guide-content-section defensive-guide-section" id="main-defensive-moves">
      <h2>Main Defensive Moves</h2>
      <div class="combo-guide-list">
        <article class="combo-guide-row">
          <div class="combo-guide-cards">
            <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-009.webp" data-image-alt="Kakashi N01-009 card" aria-label="Zoom Kakashi N01-009 card">
              <img src="/Cards/N01/N01-009.webp" alt="Kakashi N01-009" loading="lazy" />
            </button>
          </div>
          <div class="combo-guide-copy">
            <h3>Kakashi</h3>
            <p>Negate the effect of a card to stop an opposing support effect or protect an important attack.</p>
          </div>
        </article>

        <article class="combo-guide-row">
          <div class="combo-guide-cards">
            <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-018.webp" data-image-alt="Hinata N01-018 card" aria-label="Zoom Hinata N01-018 card">
              <img src="/Cards/N01/N01-018.webp" alt="Hinata N01-018" loading="lazy" />
            </button>
          </div>
          <div class="combo-guide-copy">
            <h3>Hinata</h3>
            <p>KO an opposing Character during an attack by one of your opponent’s Characters, turning their attack into a defensive opening.</p>
          </div>
        </article>

        <article class="combo-guide-row">
          <div class="combo-guide-cards">
            <button class="combo-card-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-006.webp" data-image-alt="Jiraiya N01-006 card" aria-label="Zoom Jiraiya N01-006 card">
              <img src="/Cards/N01/N01-006.webp" alt="Jiraiya N01-006" loading="lazy" />
            </button>
          </div>
          <div class="combo-guide-copy">
            <h3>Jiraiya</h3>
            <p>KO two opposing Characters in Rest, giving the deck a strong way to punish a wide board and clear blockers.</p>
          </div>
        </article>
      </div>
    </section>
    <section class="guide-content-section matchup-guide-section" id="matchup">
      <h2>Matchup</h2>
      <article class="matchup-guide-card">
        <button class="matchup-leader-preview" type="button" data-card-preview data-image-src="/Cards/N01/N01-012.webp" data-image-alt="Sasuke Uchiha N01-012 leader card" aria-label="Zoom Sasuke Uchiha N01-012 leader card">
          <img src="/Cards/N01/N01-012.webp" alt="Sasuke Uchiha leader" loading="lazy" />
        </button>
        <h3>Sasuke Uchiha</h3>
        <ul>
          <li>Aim to go second so you can draw two cards and mulligan, giving you the best chance of finding the pieces you need.</li>
          <li>Prioritize finding Gamabunta so you can access the Gamabunta–Minato combo.</li>
          <li>Try to remove the opposing Jugo from the board by KOing it with your support effects.</li>
          <li>Clear the opponent’s board whenever possible so they cannot use it to summon their EX Characters.</li>
        </ul>
      </article>
    </section>
    {guide.sections.map((section) => (
      <section class="guide-content-section" id={section.heading === 'Matchup' ? 'matchup' : undefined}>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
      </section>
    ))}
    <p class="guide-back-link"><a class="text-link" href="/deck-guides/">← Back to Deck Guides</a></p>
  </article>
</BaseLayout>

<script>
  const copyDeckButton = document.querySelector('[data-copy-deck]');
  const decklistText = `1 x N-001
3 x N-002
3 x N-004
3 x N-006
3 x N-007
3 x N-008
3 x N-009
3 x N-005
3 x N-003
3 x N-011
3 x N-018`;

  copyDeckButton?.addEventListener('click', async () => {
    if (!(copyDeckButton instanceof HTMLButtonElement)) return;
    try {
      await navigator.clipboard.writeText(decklistText);
      copyDeckButton.textContent = 'Copied!';
      window.setTimeout(() => {
        copyDeckButton.textContent = 'Copy for Sim';
      }, 1800);
    } catch {
      copyDeckButton.textContent = 'Copy failed';
      window.setTimeout(() => {
        copyDeckButton.textContent = 'Copy for Sim';
      }, 1800);
    }
  });
</script>
