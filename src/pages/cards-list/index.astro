---
import BaseLayout from '../../components/BaseLayout.astro';
import CardTile from '../../components/CardTile.astro';
import EmptyState from '../../components/EmptyState.astro';
import { cards } from '../../data/content';

const starterDeckIds = new Set(['SAMPLE-19', 'SAMPLE-20', 'SAMPLE-21']);
const firstSetIds = new Set(['SAMPLE-22', 'SAMPLE-23', 'SAMPLE-24', 'SAMPLE-25']);
const cardSections = [
  {
    title: 'Starter Deck',
    cards: cards.filter((card) => starterDeckIds.has(card.id)),
  },
  {
    title: 'First Set "Here Comes Naruto Uzumaki!"',
    cards: cards.filter((card) => firstSetIds.has(card.id)),
  },
  {
    title: 'Demo Cards',
    cards: cards.filter(
      (card) => card.setCode === 'N01' && !starterDeckIds.has(card.id) && !firstSetIds.has(card.id),
    ),
  },
  {
    title: 'Chakra Cards',
    cards: cards.filter((card) => card.setCode === 'CHAKRA'),
  },
  {
    title: 'Summon Cards',
    cards: cards.filter((card) => card.setCode === 'SUMMON'),
  },
];
---

<BaseLayout
  title="Naruto Card List"
  description="Explore the first NARUTO CARD GAME cards and browse each set as it is officially revealed."
  canonicalPath="/cards-list/"
  noindex={cards.length === 0}
>
  <header class="page-hero shell cards-list-hero">
    <p class="eyebrow card-list-eyebrow">Cards List</p>
    <h1 class="card-list-title">Naruto Card List</h1>
    <p>
      Explore the first cards of the Naruto Card Game and browse each set as it is revealed. New cards will be
      added as official releases are announced, so check back regularly.{' '}
      <a class="text-link card-list-news-link" href="/news/">
        Check the News
      </a>{' '}
      to stay up to date with the latest reveals and releases.
    </p>
  </header>

  <section class="shell section cards-list-section" aria-labelledby="card-results-title">
    <h2 id="card-results-title" class="visually-hidden">
      Card archive
    </h2>
    <div class="results-bar">
      <p id="card-result-count" aria-live="polite">
        <strong>{cards.length}</strong> {cards.length === 1 ? 'card' : 'cards'}
      </p>
    </div>

    {cards.length > 0 ? (
      <>
        {cardSections.map((section, sectionIndex) => (
          <section class="cards-list-group" aria-labelledby={`cards-section-${sectionIndex}`}>
            <h2 id={`cards-section-${sectionIndex}`}>{section.title}</h2>
            <div class="card-grid cards-list-grid" id={sectionIndex === 0 ? 'card-results' : undefined}>
              {section.cards.map((card) => (
                <CardTile card={card} eager showDetails={false} />
              ))}
            </div>
          </section>
        ))}
        <div id="card-no-results" hidden>
          <EmptyState
            title="No cards match your search"
            message="Try a different name, identifier, or set—or reset the filters."
          />
        </div>
      </>
    ) : (
      <EmptyState
        eyebrow="Archive ready"
        title="No verified cards are available yet"
        message="Card records will be added after official images, identifiers, and set information can be confirmed."
      />
    )}
  </section>
</BaseLayout>
