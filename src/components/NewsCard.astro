---
import type { NewsArticle } from '../data/content';
import { formatDate } from '../lib/format';

type Props = { article: NewsArticle; featured?: boolean };
const { article, featured = false } = Astro.props;
const cardImage = article.image ?? {
  src: '/assets/visuals/chakra-ink-news.webp',
  alt: 'NARUTO CARD GAME news artwork',
  width: 1664,
  height: 936,
};
---

<article
  class:list={['news-card', { featured, 'has-image': true }]}
  data-news-card
  data-category={article.category}
>
  <a href={`/news/${article.slug}/`}>
    <span
      class:list={['news-image', { 'news-image-overlay': Boolean(article.imageOverlayText) }]}
      style={`--image-ratio: ${cardImage.width} / ${cardImage.height}`}
    >
      <img
        class:list={{ 'news-image-background': Boolean(article.imageOverlayText) }}
        src={cardImage.src}
        alt={article.imageOverlayText ? '' : cardImage.alt}
        aria-hidden={article.imageOverlayText ? 'true' : undefined}
        width={cardImage.width}
        height={cardImage.height}
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
      {article.imageOverlayText && <span class="news-image-overlay-text">{article.imageOverlayText}</span>}
    </span>
    <span class="news-copy">
      <span class="meta-row">
        <span>{article.category}</span>
        {article.publishedAt && <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
      </span>
      <h3>{article.title}</h3>
      <span class="summary">{article.summary}</span>
      <span class="card-action">
        Read article <span aria-hidden="true">→</span>
      </span>
    </span>
  </a>
</article>
