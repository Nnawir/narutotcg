---
import type { NewsArticle } from '../data/content';
import { formatDate } from '../lib/format';

type Props = {
  article: NewsArticle;
  featured?: boolean;
  showImage?: boolean;
  compact?: boolean;
  clickable?: boolean;
  href?: string;
  previewImage?: NewsArticle['image'];
  actionHref?: string;
  actionLabel?: string;
};
const {
  article,
  featured = false,
  showImage = true,
  compact = false,
  clickable = true,
  href,
  previewImage,
  actionHref,
  actionLabel = 'Read article',
} = Astro.props;
const cardImage = article.image ?? {
  src: '/assets/visuals/chakra-ink-news.webp',
  alt: 'NARUTO CARD GAME news artwork',
  width: 1664,
  height: 936,
};
---

<article
  class:list={['news-card', { featured, 'has-image': showImage, 'latest-news-card': compact, 'static-news-card': !clickable }]}
  data-news-card
  data-category={article.category}
>
  {clickable ? (
    previewImage ? (
      <button
        class="news-card-preview-link"
        type="button"
        data-card-preview
        data-image-src={previewImage.src}
        data-image-alt={previewImage.alt}
        aria-label={`View ${article.title}`}
      >
        <span class="news-copy">
          <span class="meta-row">
            <span>{article.category}</span>
            {article.publishedAt && <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
          </span>
          {!compact && <h3>{article.title}</h3>}
          <span class="summary">{article.summary}</span>
          <span class="card-action">{actionLabel} <span aria-hidden="true">→</span></span>
        </span>
      </button>
    ) : (
    <a href={href ?? `/news/${article.slug}/`}>
      {showImage && (
        <span
          class:list={[
            'news-image',
            {
              'news-image-overlay': Boolean(article.imageOverlayText),
              'news-image-focus-top': article.slug === 'starter-deck-update-product-information-slides',
            },
          ]}
          style={`--image-ratio: ${cardImage.width} / ${cardImage.height}`}
        >
          <img
            class:list={{ 'news-image-background': Boolean(article.imageOverlayText) }}
            src={cardImage.src}
            alt={article.imageOverlayText ? '' : cardImage.alt}
            aria-hidden={article.imageOverlayText ? 'true' : undefined}
            width={cardImage.width}
            height={cardImage.height}
            loading={featured ? 'eager' : 'lazy'}
            decoding="async"
          />
          {article.imageOverlayText && <span class="news-image-overlay-text">{article.imageOverlayText}</span>}
        </span>
      )}
      <span class="news-copy">
        <span class="meta-row">
          <span>{article.category}</span>
          {article.publishedAt && <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
        </span>
        {!compact && <h3>{article.title}</h3>}
        <span class="summary">{article.summary}</span>
        <span class="card-action">{actionLabel} <span aria-hidden="true">→</span></span>
      </span>
    </a>
    )
  ) : (
    <div class="news-card-static-link">
      <span class="news-copy">
        <span class="meta-row">
          <span>{article.category}</span>
          {article.publishedAt && <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
        </span>
        {!compact && <h3>{article.title}</h3>}
        <span class="summary">{article.summary}</span>
        {actionHref && <a class="card-action" href={actionHref}>{actionLabel} <span aria-hidden="true">→</span></a>}
      </span>
    </div>
  )}
</article>
